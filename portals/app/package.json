{
  "name": "@bidproposal/app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4070",
    "prisma:generate": "prisma generate",
    "build": "node workbench/build.mjs && prisma generate && next build",
    "start": "next start",
    "type-check": "prisma generate && tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-coverage \"app/**/*.test.ts\" && pnpm --filter @bidproposal/workbench test && pnpm --filter @bidproposal/desktop test"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@bidproposal/shared": "workspace:*",
    "@bidproposal/workbench": "workspace:*",
    "@vxture/design-system": "15.11.0",
    "@vxture/shared": "^1.6.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@vxture/ruyin-core": "0.2.2",
    "@vxture/ruyin-contract-schema": "0.2.2",
    "@vxture/ruyin-document": "0.2.2",
    "@vxture/ruyin-node-runtime": "0.2.2",
    "@vxture/ruyin-workbench-ui": "0.2.2",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
