{
  "name": "vxture-bidproposal",
  "version": "0.0.0",
  "private": true,
  "description": "bidproposal - a deployed Vxture product and the reference build new product repos are copied from.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "fast-uri@<4.1.3": ">=4.1.3",
      "hono@<4.13.5": ">=4.13.5",
      "mysql2@<3.23.1": ">=3.23.1",
      "nanoid@<3.3.17": ">=3.3.17",
      "postcss@<8.5.23": ">=8.5.23",
      "sharp@<0.35.4": ">=0.35.4",
      "valibot@<1.4.2": ">=1.4.2"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @bidproposal/app dev",
    "build": "pnpm --filter @bidproposal/app build",
    "start": "pnpm --filter @bidproposal/app start",
    "test": "pnpm --recursive --if-present test",
    "type-check:all": "pnpm --recursive --if-present type-check",
    "lint": "pnpm --recursive --if-present lint",
    "lint:docs-numbering": "node scripts/guardrails/check-docs-numbering.mjs --strict",
    "lint:data-design": "node scripts/guardrails/check-data-architecture.mjs --strict",
    "lint:placeholders": "node scripts/guardrails/check-no-placeholders.mjs --strict",
    "lint:ports": "node scripts/guardrails/check-port-consistency.mjs --strict",
    "lint:ruleset": "node scripts/guardrails/check-ruleset.mjs --strict",
    "lint:sca": "node scripts/guardrails/check-sca-consistency.mjs --strict"
  }
}
